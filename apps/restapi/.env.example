# =============================================================================
# REST API — copy values into Dokploy env (runtime)
# Local: .env.development.local | .env.production.local
# =============================================================================

PORT=5000
NODE_ENV=development

# Required — use a long random string in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional — enables card payments when set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Database adapter: in_memory | mongoose (see @luxe-maison/database)
# DATABASE_ADAPTER=in_memory
# MONGODB_URI=
