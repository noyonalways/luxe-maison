# =============================================================================
# Admin CMS — copy values into Dokploy env
# VITE_* must be set at BUILD time (baked into the client bundle)
# PREVIEW_* / PORT are runtime for `vite preview`
# Local: .env.development.local | .env.production.local
# =============================================================================

# Storefront origin (preview links, “view site”)
VITE_STOREFRONT_URL=http://localhost:3000

# REST API origin. Leave empty in local dev to use Vite /api proxy.
# In production set to the public API URL.
VITE_API_URL=

# Vite proxy target when VITE_API_URL is empty (dev + preview)
VITE_API_PROXY_TARGET=http://localhost:5000

# Preview host allowlist (`*` = all). Runtime only.
PREVIEW_ALLOWED_HOSTS=*

# App port (Dokploy)
PORT=5173
HOST=0.0.0.0
