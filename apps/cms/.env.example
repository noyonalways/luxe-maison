# Admin CMS — separate origin from storefront
VITE_STOREFRONT_URL=http://localhost:3000
# Leave empty in dev to use Vite proxy (/api -> restapi)
VITE_API_URL=
# Preview host allowlist (Dokploy). `*` or omit = allow all; or comma-separated hosts
# PREVIEW_ALLOWED_HOSTS=admin.luxe-maison.noyonrahman.com
# Optional: upstream for /api proxy during vite preview
# VITE_API_PROXY_TARGET=https://api.luxe-maison.noyonrahman.com
